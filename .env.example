# Node & Server Config
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
WEB_URL=http://localhost:5173
API_URL=http://localhost:3001

# Database (Prisma / MySQL)
DATABASE_URL="mysql://starter_user:starter_password@localhost:3306/starter_kit_db"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-starter-kit-2026"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 / MinIO File Upload
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_BUCKET_NAME=starter-kit-uploads
S3_FORCE_PATH_STYLE=true

# Email Service (Mailpit / SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StarterKit Support <no-reply@starterkit.com>"
